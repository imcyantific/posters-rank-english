{
  "version": 2,
  "regions": ["syd1"],
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["*.ttf", "tessdata/**", "node_modules/tesseract.js/**", "node_modules/tesseract.js-core/**"], "maxDuration": 60 }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [
    { "path": "/warm?type=movie", "schedule": "10 12 * * *" },
    { "path": "/warm?type=series", "schedule": "20 12 * * *" }
  ]
}
